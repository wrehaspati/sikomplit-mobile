{
  "expo": {
    "name": "Pengajuan Izin Penelitian",
    "description": "Pengembangan Sistem Layanan Rekomendasi Penelitian",
    "slug": "sikomplit-mobile",
    "sdkVersion": "57.0.0",
    "version": "1.4.0-beta",
    "platforms": ["android"],
    "orientation": "portrait",
    "icon": "./assets/images/android-icon-foreground.png",
    "scheme": "sikomplitmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#f2f2f2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "googleServicesFile": "./google-services.json",
      "package": "com.dereyn.sikomplitmobile",
      "versionCode": 9
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#f2f2f2",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-video",
      "expo-secure-store",
      [
        "expo-file-system",
        {
          "supportsOpeningDocumentsInPlace": true,
          "enableFileSharing": true
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-web-browser",
      "expo-sharing",
      "expo-notifications",
      "expo-mail-composer",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.dereyn.** { *; }"
          }
        }
      ],
      "expo-font",
      "expo-image",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1839ea87-7e53-436e-9ac2-c68414cc46b3"
      }
    },
    "owner": "dereyn"
  }
}
